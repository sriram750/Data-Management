# ==============================================================================
# DATAMATRIX ENTERPRISE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Metadata
APP_NAME=DataMatrix Enterprise Platform
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False

# Host HTTP Port (default: 80, can be set to 8080, 8085, etc. if 80 is busy)
HTTP_PORT=80

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ReplaceWithStrongDatabasePassword_32Chars!
POSTGRES_DB=datamatrix
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Connection URLs
# Asyncpg driver URL for FastAPI asynchronous SQLAlchemy engine
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Sync psycopg2 driver URL for Alembic database migrations and background sync jobs
SYNC_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Cryptographic Keys (Must be 32+ hex/base64 random characters)
SECRET_KEY=generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
ENCRYPTION_MASTER_KEY=generate_with_openssl_rand_hex_32

# Security & Session Policies
SESSION_TIMEOUT_MINUTES=60
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# File Attachment Storage
UPLOAD_STORAGE_PATH=/app/storage/attachments
UPLOAD_DIR=/app/storage/attachments
MAX_UPLOAD_SIZE_MB=50

# LDAP / Active Directory Integration (Optional)
LDAP_ENABLED=False
LDAP_SERVER=ldap://ad.company.com
LDAP_PORT=389
LDAP_USE_SSL=False
LDAP_USE_TLS=True
LDAP_BIND_DN=CN=DataMatrix Service,OU=Service Accounts,DC=company,DC=com
LDAP_BIND_PASSWORD=ServiceAccountPassword
LDAP_BASE_DN=DC=company,DC=com
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_GROUP_SEARCH_FILTER=(member={user_dn})
LDAP_AUTO_CREATE_USER=True
LDAP_DEFAULT_ROLE_ID=
